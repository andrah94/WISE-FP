# Database
DATABASE_URL=postgresql://user:password@host:5432/railway

# Google OAuth Credentials (JSON string for each account)
GMAIL_TOKEN_GWINDOMFINANCE=<token_json>
GMAIL_TOKEN_WISEFINANCIAL=<token_json>
GOOGLE_CALENDAR_TOKEN=<token_json>

# Google OAuth Client Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=<your_client_id>
GOOGLE_CLIENT_SECRET=<your_client_secret>

# Calendly
CALENDLY_API_KEY=<your_calendly_api_key>

# Server
PORT=8080
UPDATE_INTERVAL_MINUTES=15

# Optional: Notification webhook (Slack, Discord, etc.)
NOTIFICATION_WEBHOOK_URL=
